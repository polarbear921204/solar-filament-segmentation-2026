digraph G {
 graph [fontname="Noto Sans CJK TC", bgcolor="white", rankdir=TB, pad="0.22", nodesep="0.3", ranksep="0.45", compound=true, label="V11.3 太陽暗條實例分割｜最高分 0.39 系統架構", labelloc="t", fontsize=23, fontcolor="#183048"];
 node [shape=box, style="rounded,filled", fontname="Noto Sans CJK TC", fontsize=13, color="#D4DFEA", fillcolor="#F4F8FC", fontcolor="#1F3444", penwidth=1.2, margin="0.16,0.11"];
 edge [color="#69859B", arrowsize=0.72, penwidth=1.4];
 subgraph cluster_train {label="離線訓練 / Training"; fontsize=16; fontname="Noto Sans CJK TC"; fontcolor="#0F4D63"; style="rounded,filled"; color="#A6D4E4"; fillcolor="#F0F9FC";
 A [label="MAGFiLO H-alpha 2048×2048\n707 實際影像 / 1154 標註紀錄"];
 B [label="physical_key 分組\n3-Fold (防同張影像洩漏)"];
 C [label="1024×1024 Patch\nstride=768 / YOLO polygons"];
 D0 [label="YOLOv8m-seg\nFold 0 • seed 42",fillcolor="#DFEFFB"];
 D1 [label="YOLOv8m-seg\nFold 1 • seed 43",fillcolor="#DFEFFB"];
 D2 [label="YOLOv8m-seg\nFold 2 • seed 44",fillcolor="#DFEFFB"];
 A->B->C;
 C->D0;C->D1;C->D2;
 }
 subgraph cluster_infer {label="測試推論 / Inference";fontsize=16;fontname="Noto Sans CJK TC";fontcolor="#255A3D";style="rounded,filled";color="#ABD5C2";fillcolor="#F3FAF6";
 T [label="Test H-alpha 原圖\n180 張 / 2048×2048",fillcolor="#E5F3E8"];
 P [label="重疊切片\n1024 tile / stride 768"];
 I [label="3 模型逐 tile 預測\nPatch→Native Mask Merge",fillcolor="#DFF3EA"];
 E [label="跨模型 Instance Clustering\nIoU≥0.25 或 containment≥0.55"];
 V [label="至少 2 個模型支持\nPixel Vote threshold 0.50"];
 N [label="去重 + confidence 優先\nExclusive pixels / max 15"];
 R [label="V11.3 新增：Image-guided Trim1\n雙尺度 Gaussian + 3×3 Rim\n只移除局部偏亮邊界",fillcolor="#FFECCE",color="#F0B86F",penwidth=2];
 O [label="Compressed COCO RLE\nfilament_id, segmentation_rle"];
 L [label="Kaggle Public LB 0.39",fillcolor="#D6E8FD",color="#88AFDB",penwidth=2];
 T->P->I->E->V->N->R->O->L;
 T->R [label="原始像素",fontsize=10,fontcolor="#69859B",style=dotted,constraint=false];
 }
 D0->I [style=dashed,color="#8FABC4",constraint=false];
 D1->I [style=dashed,color="#8FABC4",constraint=false];
 D2->I [style=dashed,color="#8FABC4",constraint=false];
}
